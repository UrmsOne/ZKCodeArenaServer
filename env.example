# ZK Code Arena Server 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development

# 数据库配置
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=zk_code_arena

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=zk-code-arena-secret-key-2025
JWT_EXPIRE_TIME=24h

# 评测服务配置
JUDGE_URL=http://localhost:5050/run
JUDGE_TIMEOUT=30s

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# 文件上传配置
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx

# 邮件配置（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
