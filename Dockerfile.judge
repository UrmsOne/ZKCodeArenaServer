FROM criyle/go-judge:latest

# 备份原 sources.list 并替换为阿里云 Debian 镜像源
# 注意：需先确认原系统是 Debian，且版本号（如 bookworm、bullseye）
# 通常 criyle/go-judge 使用 Debian 11 (bullseye) 或 10 (buster)

# Debian 通常的源文件路径是 /etc/apt/sources.list
# 我们通过 sed 或 echo 直接覆盖（推荐在知道版本的情况下操作）

# 假设基础镜像是 Debian 11 (bullseye)，使用阿里云镜像
RUN sed -i 's|http.*debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|httpredir.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

# 如果你明确知道是 Debian 10 (buster)，也可以使用如下内容替换 sources.list：
# RUN echo "deb http://mirrors.aliyun.com/debian/ buster main contrib non-free\ndeb http://mirrors.aliyun.com/debian/ buster-updates main contrib non-free\ndeb http://mirrors.aliyun.com/debian-security/ buster/updates main contrib non-free" > /etc/apt/sources.list

# 或者 Debian 11 (bullseye):
# RUN echo "deb http://mirrors.aliyun.com/debian/ bullseye main contrib non-free\ndeb http://mirrors.aliyun.com/debian/ bullseye-updates main contrib non-free\ndeb http://mirrors.aliyun.com/debian-security/ bullseye-security main contrib non-free" > /etc/apt/sources.list

# 更新并安装 Java 17
RUN apt-get update && \
    apt-get install -y openjdk-17-jdk && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 设置 JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$PATH:$JAVA_HOME/bin

# 验证安装
RUN java -version && javac -version

# 确保 Java 目录可被访问
RUN if [ -d "$JAVA_HOME" ]; then \
        chmod -R a+r "$JAVA_HOME" && \