FROM criyle/go-judge:latest

# 使用默认用户权限安装Java 17
# 如果基础镜像已经配置了合适的用户，我们不需要切换用户

# 更新包管理器并安装Java 17
RUN apt-get update && \
    apt-get install -y openjdk-17-jdk && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 设置JAVA_HOME环境变量
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$PATH:$JAVA_HOME/bin

# 验证Java安装
RUN java -version && javac -version

# 确保应用程序可以访问Java安装
RUN if [ -d "/usr/lib/jvm/java-17-openjdk-amd64" ]; then \
        chmod -R a+r /usr/lib/jvm/java-17-openjdk-amd64 && \
        find /usr/lib/jvm/java-17-openjdk-amd64 -type d -exec chmod a+x {} \; ; \
    fi